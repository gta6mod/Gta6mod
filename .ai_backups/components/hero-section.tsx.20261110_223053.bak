                      active
                        ? 'bg-[#FF2A85] text-white font-semibold'
                        : 'text-slate-300 hover:text-white hover:bg-white/5'
                    }`}
                  >
                    {tab.label}
                  </button>
                );
              })}
            </div>

            <div className="flex items-center gap-2 text-xs text-slate-300">
              <ShieldAlert className="w-4 h-4 text-[#FACC15] shrink-0" />
              <span>
